generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  password          String
  role              String             @default("INFLUENCER")
  pushToken         String?
  createdAt         DateTime           @default(now())
  partnerships      Partnership[]
  notifications     Notification[]
  invoices          Invoice[]
  sentMessages      Message[]
  pushSubscriptions PushSubscription[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Brand {
  id           String        @id @default(cuid())
  name         String
  logo         String?
  publicToken  String        @unique @default(cuid())
  createdAt    DateTime      @default(now())
  partnerships Partnership[]
  sales        BrandSale[]
}

model Partnership {
  id                String     @id @default(cuid())
  name              String
  brandId           String
  influencerId      String
  totalPrice        Float
  netPrice          Float
  brief             String?
  status            String     @default("ACTIVE")
  campaignType      String?
  campaignObjective String?
  campaignScript    String?
  createdAt         DateTime   @default(now())
  brand             Brand      @relation(fields: [brandId], references: [id])
  influencer        User       @relation(fields: [influencerId], references: [id])
  contents          Content[]
  invoice           Invoice?
  sales             BrandSale[]
  messages          Message[]
}

model Content {
  id               String          @id @default(cuid())
  partnershipId    String
  type             String
  description      String?
  postLink         String?
  postInstructions String?
  postScheduledAt  DateTime?
  contentStatus    String          @default("BOZZA")
  createdAt        DateTime        @default(now())
  partnership      Partnership     @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  tasks            ContentTask[]
  metrics          ContentMetric[]
}

model ContentTask {
  id            String    @id @default(cuid())
  contentId     String
  type          String
  status        String    @default("PENDING")
  dueDate       DateTime?
  notes         String?
  revisionNotes String?
  completedAt   DateTime?
  order         Int
  createdAt     DateTime  @default(now())
  content       Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
}

model ContentMetric {
  id         String   @id @default(cuid())
  contentId  String
  views      Int      @default(0)
  linkClicks Int      @default(0)
  reportedAt DateTime @default(now())
  content    Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String      @id @default(cuid())
  partnershipId String      @unique
  influencerId  String
  amount        Float
  fileUrl       String?
  fileName      String?
  status        String      @default("PENDING")
  submittedAt   DateTime?
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime    @default(now())
  partnership   Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  influencer    User        @relation(fields: [influencerId], references: [id])
}

model BrandSale {
  id            String      @id @default(cuid())
  brandId       String
  partnershipId String?
  amount        Float
  date          DateTime
  notes         String?
  createdAt     DateTime    @default(now())
  brand         Brand       @relation(fields: [brandId], references: [id])
  partnership   Partnership? @relation(fields: [partnershipId], references: [id])
}

model Message {
  id            String      @id @default(cuid())
  partnershipId String
  senderId      String
  senderName    String
  senderRole    String
  content       String?
  fileUrl       String?
  fileName      String?
  createdAt     DateTime    @default(now())
  partnership   Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  sender        User        @relation(fields: [senderId], references: [id])
}
